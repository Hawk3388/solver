GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Shared defaults for web, CLI and Python API.
SOLVER_MODEL=qwen3.8
SOLVER_LOCAL=true
SOLVER_THINK=false

# A single background worker processes a bounded number of queued batches.
SOLVER_MAX_PENDING_JOBS=4
SOLVER_JOB_TTL_SECONDS=3600
SOLVER_REQUEST_TIMEOUT_SECONDS=180
# Stop a local generation that keeps streaming for too long.
SOLVER_OLLAMA_MAX_SECONDS=600
SOLVER_MAX_BATCH_FILES=10
SOLVER_MAX_FILE_MB=10

# Optional paths for explicitly approved local feedback and training samples.
# SOLVER_FEEDBACK_DIR=D:/path/to/feedback
# SOLVER_DATASET_DIR=D:/path/to/dataset
